/* Lis Kliyan nan Sidebar */
.clients-list-container {
    max-height: 300px;
    overflow-y: auto;
    padding: 10px;
}
.client-sidebar-item {
    display: flex;
    align-items: center;
    padding: 8px;
    margin-bottom: 5px;
    cursor: pointer;
    border-radius: 5px;
    transition: background 0.3s;
}
.client-sidebar-item:hover {
    background: rgba(255, 255, 255, 0.1);
}
.client-avatar-mini {
    width: 35px;
    height: 35px;
    background: #007bff;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin-right: 10px;
}

/* Stil pou Pop-up Modal la */
.modal-hidden {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0,5);
}
.modal-content {
    background-color: #fff;
    color: #333;
    margin: 10% auto;
    padding: 20px;
    border-radius: 8px;
    width: 80%;
    max-width: 600px;
    position: relative;
}
.close-modal-btn {
    position: absolute;
    right: 20px;
    top: 10px;
    font-size: 28px;
    cursor: pointer;
}
.client-avatar-large {
    width: 60px;
    height: 60px;
    background: #28a745;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

/* Badges pou analiz rezo a */
.badge { padding: 5px 10px; border-radius: 20px; font-weight: bold; color: white; }
.badge-moncash { background-color: #dc3545; } /* Wouj */
.badge-natcash { background-color: #007bff; } /* Ble */
.badge-egal { background-color: #6c757d; }

